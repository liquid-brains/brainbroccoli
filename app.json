{
  "expo": {
    "name": "Brain Broccoli",
    "slug": "brainbroccoli",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "./plugins/with-device-network.js",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.brainbroccoli.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connect to your NeuroPro2 on the local network."
      }
    },
    "android": {
      "package": "org.brainbroccoli.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#b2d1a2"
      },
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan"
    }
  }
}
